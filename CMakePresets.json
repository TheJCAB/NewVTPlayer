{
    "version": 2,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 5
    },
    "configurePresets": [
        {
            "name": "base",
            "displayName": "Basic Config",
            "description": "Basic build using Ninja generator",
            "generator": "Ninja",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}"
        },

        { "name": "x64"  , "cacheVariables": { "TARGET_ARCHITECTURE": "x64"  }, "architecture": { "value": "x64"  , "strategy": "external" }, "hidden": true },
        { "name": "x86"  , "cacheVariables": { "TARGET_ARCHITECTURE": "x86"  }, "architecture": { "value": "x86"  , "strategy": "external" }, "hidden": true },
        { "name": "ARM"  , "cacheVariables": { "TARGET_ARCHITECTURE": "arm"  }, "architecture": { "value": "arm"  , "strategy": "external" }, "hidden": true },
        { "name": "ARM64", "cacheVariables": { "TARGET_ARCHITECTURE": "arm64"}, "architecture": { "value": "arm64", "strategy": "external" }, "hidden": true },
        { "name": "WASM" , "cacheVariables": { "TARGET_ARCHITECTURE": "wasm" }, "architecture": { "value": "wasm" , "strategy": "external" }, "hidden": true },

        { "name": "Debug"   , "cacheVariables": { "BUILD_TYPE": "Debug"   , "CMAKE_BUILD_TYPE": "Debug"          }, "hidden": true },
        { "name": "Checked" , "cacheVariables": { "BUILD_TYPE": "Checked" , "CMAKE_BUILD_TYPE": "RelWithDebInfo" }, "hidden": true },
        { "name": "Release" , "cacheVariables": { "BUILD_TYPE": "Release" , "CMAKE_BUILD_TYPE": "Release"        }, "hidden": true },
        { "name": "Analysis", "cacheVariables": { "BUILD_TYPE": "Analysis", "CMAKE_BUILD_TYPE": "Debug"          }, "hidden": true },

        { "name": "MSVC"   , "hidden": true, "cacheVariables": { "COMPILER_TOOLCHAIN": "MSVC"      , "CMAKE_CXX_COMPILER": "cl.exe"      , "CMAKE_C_COMPILER": "cl.exe"       }, "toolset": { "value": "host=x64", "strategy": "external" } },
        { "name": "ClangCl", "hidden": true, "cacheVariables": { "COMPILER_TOOLCHAIN": "Clang"     , "CMAKE_CXX_COMPILER": "clang-cl.exe", "CMAKE_C_COMPILER": "clang-cl.exe" }, "toolset": { "value": "host=x64", "strategy": "external" } },
        { "name": "EM"     , "hidden": true, "cacheVariables": { "COMPILER_TOOLCHAIN": "Emscripten", "CMAKE_TOOLCHAIN_FILE": "C:/Users/thejc/repos/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake", "CMAKE_CROSSCOMPILING_EMULATOR": "C:/Users/thejc/repos/emsdk/node/14.18.2_64bit/bin/node.exe;--experimental-wasm-bulk-memory;--experimental-wasm-threads" } },
        
        { "name": "x64-Debug-Win32"      , "inherits": [ "base", "x64"  , "Debug"   , "MSVC"    ] },
        { "name": "x64-Debug-ClangCl"    , "inherits": [ "base", "x64"  , "Debug"   , "ClangCl" ] },
        { "name": "WASM-Debug-EM"        , "inherits": [ "base", "WASM" , "Debug"   , "EM"      ] },
        { "name": "WASM-Release-EM"      , "inherits": [ "base", "WASM" , "Release" , "EM"      ] }
    ]
}
