{
    "liveServer.settings.port": 4500,
    "liveServer.settings.cors": true,
    "liveServer.settings.headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp",
    },
    "liveServer.settings.donotShowInfoMsg": true,
    "liveServer.settings.root": "/www",
    "liveServer.settings.ChromeDebuggingAttachment": true,
    "liveServer.settings.NoBrowser" : false,
    "liveServer.settings.ignoreFiles" : [
            ".cmake/**",
            "CMakeFiles/**",
            "*Cmake*",
            "*ninja*"
    ],
    "liveServer.settings.mount": [
        ["/js", "./js"],
        ["/js", "./build/WASM-Debug-EM/bin"]
    ],
    "files.associations": {
        "*.json": "jsonc",
        "coroutine": "cpp",
        "__bit_reference": "cpp",
        "__bits": "cpp",
        "__config": "cpp",
        "__debug": "cpp",
        "__hash_table": "cpp",
        "__node_handle": "cpp",
        "__split_buffer": "cpp",
        "__threading_support": "cpp",
        "__tree": "cpp",
        "__tuple": "cpp",
        "__verbose_abort": "cpp",
        "array": "cpp",
        "atomic": "cpp",
        "bit": "cpp",
        "cctype": "cpp",
        "cmath": "cpp",
        "cstdarg": "cpp",
        "cstddef": "cpp",
        "cstdint": "cpp",
        "cstdio": "cpp",
        "cstdlib": "cpp",
        "cstring": "cpp",
        "ctime": "cpp",
        "cwchar": "cpp",
        "cwctype": "cpp",
        "exception": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "limits": "cpp",
        "map": "cpp",
        "memory": "cpp",
        "new": "cpp",
        "optional": "cpp",
        "ratio": "cpp",
        "set": "cpp",
        "span": "cpp",
        "stdexcept": "cpp",
        "string": "cpp",
        "string_view": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "typeinfo": "cpp",
        "unordered_map": "cpp",
        "variant": "cpp",
        "vector": "cpp",
        "algorithm": "cpp",
        "xstring": "cpp",
        "random": "cpp"
    },
}